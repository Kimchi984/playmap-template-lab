            "tag",
            "none"
          ],
          "valueLabels": {
            "plain": "Plain text",
            "tag": "Filled tag",
            "none": "No price"
          },
          "default": "plain"
        }
      },
      "assetSlots": {
        "visual": {
          "role": "visual",
          "optional": false,
