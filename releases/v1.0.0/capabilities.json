            "none"
          ],
          "valueLabels": {
            "soft-fade": "Soft backdrop · follows copy",
            "none": "Full colour · no fade"
          },
          "default": "soft-fade",
          "visibleWhen": {
            "treatment": [
              "visual-below"
            ],
            "imageFit": [
              "frame"
            ]
          },
          "help": "A feathered backdrop follows the actual text area, leaving the rest of the image clear."
        },
        "priceTreatment": {
          "type": "enum",
          "label": "Price treatment",
          "values": [
